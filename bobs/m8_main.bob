      </color>
    </background_color>
    <rules>
      <rule name="EDM visibility" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0&gt;=1.0 &amp;&amp; pv0&lt;2.0">
          <value>true</value>
        </exp>
        <exp bool_exp="true">
          <value>false</value>
        </exp>
        <pv_name>=`$(NAME):ARM12`||`$(NAME):ARM34`||`$(NAME):ARM56`||`$(NAME):ARM78`</pv_name>
      </rule>
    </rules>
  </widget>
