              </foreground_color>
              <background_color>
                <color name="grey-4" red="187" green="187" blue="187">
                </color>
              </background_color>
              <tooltip>$(actions)</tooltip>
            </widget>
          </widget>
        </children>
      </tab>
    </tabs>
    <width>856</width>
    <height>520</height>
    <background_color>
      <color red="200" green="200" blue="200">
      </color>
    </background_color>
    <active_tab>2</active_tab>
  </widget>
</display>
